{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apexglass",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "apex-frameless-db",
    "database_id": "f78cd092-5272-43c3-a3a5-ed866660cedf"
  }],
  "r2_buckets": [{
    "binding": "PORTFOLIO_BUCKET",
    "bucket_name": "apex-portfolio"
  }],
  "vars": {
    "SITE_URL": "https://apexframelessglass.com.au",
    "ADMIN_EMAILS": "REPLACE_WITH_ADMIN_EMAILS",
    "INSTAGRAM_API_VERSION": "v24.0",
    "INSTAGRAM_API_BASE": "https://graph.instagram.com",
    "INSTAGRAM_CACHE_MINUTES": "60"
  }
}
